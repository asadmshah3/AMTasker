  "description": "AMTasker: a local-first daily task and time logger. Your data stays in your browser.",
  "private": true,
  "license": "MIT",
  "author": "Asad Mehmood Shah",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
